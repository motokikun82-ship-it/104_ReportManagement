<Window x:Class="ReportManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReportManagement.ViewModels"
        xmlns:conv="clr-namespace:ReportManagement.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="📋 業務日報管理" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Closing="Window_Closing">

    <!-- カスタムタイトルバー用 WindowChrome -->
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome
                        CaptionHeight="0"
                        ResizeBorderThickness="5"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:BoolToStrikethroughConverter x:Key="BoolToStrike"/>
        <conv:BoolToOpacityConverter x:Key="BoolToOp"/>
        <conv:StringEmptyToVisibilityConverter x:Key="StrEmpToVis"/>
        <conv:BoolToExpandIconConverter x:Key="BoolToExpandIcon"/>
        <conv:HolidayBrushConverter x:Key="HolidayBrushConv"/>
        <conv:StringEmptyToNullConverter x:Key="StrEmpToNull"/>
        <conv:ExecutedBrushConverter x:Key="ExecutedBrushConv"/>
    </Window.Resources>

    <Grid Background="{StaticResource BrushBgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- カスタムタイトルバー -->
            <RowDefinition Height="Auto"/> <!-- トップバー（検索・ナビ） -->
            <RowDefinition Height="*"/>    <!-- メインコンテンツ -->
            <RowDefinition Height="30"/>   <!-- ステータスバー -->
        </Grid.RowDefinitions>

        <!-- ═══ カスタムタイトルバー ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgSecondary}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- アイコン＋タイトル -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="📋" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="業務日報管理" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- ウィンドウコントロールボタン -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 最小化 -->
                    <Button x:Name="BtnMinimize" Content="─" Width="44" Height="32"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            FontSize="11" Click="BtnMinimize_Click" Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最小化"/>
                    <!-- 最大化/復元 -->
                    <Button x:Name="BtnMaximize" Content="□" Width="44" Height="32"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            FontSize="11" Click="BtnMaximize_Click" Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最大化"/>
                    <!-- 閉じる -->
                    <Button x:Name="BtnClose" Content="✕" Width="44" Height="32"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                            FontSize="11" Click="BtnClose_Click" Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="閉じる">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Width="44" Height="32">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- トップバー（検索・日付ナビ・ツール） -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgSecondary}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 検索エリア -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             d:Text="検索キーワード..."
                             ToolTip="項目名やメモのキーワードで検索（インクリメンタル）"/>
                </StackPanel>

                <!-- 日付表示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BtnIcon}" Command="{Binding PrevDayCommand}" ToolTip="前日">◀</Button>
                    <TextBlock Text="{Binding DateLabel}" FontSize="18" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                    <Button Style="{StaticResource BtnIcon}" Command="{Binding NextDayCommand}" ToolTip="翌日">▶</Button>
                    <Button Style="{StaticResource BtnSecondary}" Margin="10,0,0,0" Command="{Binding GoTodayCommand}">今日</Button>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSecondary}" Click="OpenTemplateManager_Click" Margin="0,0,5,0">
                        テンプレート管理 ⚙️
                    </Button>
                    <Button Style="{StaticResource BtnSecondary}" Click="OpenNotesWindow_Click" Margin="0,0,5,0">
                        📝 メモ
                    </Button>
                    <Button Style="{StaticResource BtnSecondary}" Click="OpenAggregation_Click" Margin="0,0,5,0">
                        📊 集計
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" Click="OpenSettings_Click" ToolTip="設定">⚙</Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/> <!-- 左: 日報 / 検索結果 -->
                <ColumnDefinition Width="Auto"/> <!-- スプリッター -->
                <ColumnDefinition Width="3*"/> <!-- 右: カレンダー + ToDo -->
            </Grid.ColumnDefinitions>

            <!-- ＝＝＝ 左ペイン：通常ビュー ＝＝＝ -->
            <Grid Grid.Column="0" Margin="15" Visibility="{Binding IsNormalMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- テンプレ・項目追加バー -->
                <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="150" ItemsSource="{Binding TemplateGroups}" SelectedItem="{Binding SelectedTemplateGroup}" DisplayMemberPath="GroupName" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource BtnSecondary}" Command="{Binding AddFromTemplateCommand}">＋ テンプレから追加</Button>
                        <Separator Width="1" Margin="15,0" Background="{StaticResource BrushBorder}"/>
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding AddFreeEntryCommand}" Margin="0,0,10,0">＋ 自由追加</Button>
                        <Button Style="{StaticResource BtnSecondary}" Command="{Binding AddMemoEntryCommand}" Margin="0,0,10,0">📝 突発メモ追加</Button>
                        <Button Style="{StaticResource BtnPrimary}" Click="OpenFavoriteItems_Click">⭐ よく使う</Button>
                    </StackPanel>
                </Border>

                <!-- 日報エントリーリスト -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                                    <Grid>
                                        <!-- 通常項目（件数あり） -->
                                        <Grid Visibility="{Binding IsCountable, Converter={StaticResource BoolToVis}}" Margin="6,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 実行チェック（要チェック項目のみ表示） -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsExecuted}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVis}}" ToolTip="実行済みにする"/>

                                            <!-- 項目名（実行済みは薄グレー） -->
                                            <TextBox Grid.Column="1" Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                     Foreground="{Binding IsDimmed, Converter={StaticResource ExecutedBrushConv}}"/>

                                            <!-- 未実行警告 -->
                                            <TextBlock Grid.Column="1" Text="⚠" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="12"
                                                       Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVis}}" ToolTip="未実行です"/>

                                            <!-- 件数操作 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                                                <Button Style="{StaticResource BtnIcon}" Command="{Binding DecrementCommand}" Background="{StaticResource BrushBgHover}" Padding="2">➖</Button>
                                                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="40" TextAlignment="Center" Margin="4,0"/>
                                                <Button Style="{StaticResource BtnIcon}" Command="{Binding IncrementCommand}" Background="{StaticResource BrushBgHover}" Padding="2">➕</Button>
                                                <TextBlock Text="件" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>

                                            <!-- メモアイコン -->
                                            <TextBlock Grid.Column="3" Text="📝" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>

                                            <!-- メモ入力 -->
                                            <TextBox Grid.Column="4" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="補足メモ" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                            <!-- 移動ボタン -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,4,0">
                                                <Button Style="{StaticResource BtnIcon}" Command="{Binding MoveUpCommand}" FontSize="11" Padding="1" ToolTip="上に移動">↑</Button>
                                                <Button Style="{StaticResource BtnIcon}" Command="{Binding MoveDownCommand}" FontSize="11" Padding="1" ToolTip="下に移動">↓</Button>
                                            </StackPanel>

                                            <!-- 削除ボタン -->
                                            <Button Grid.Column="6" Style="{StaticResource BtnDanger}" Command="{Binding RequestDeleteCommand}" Padding="4,2">🗑</Button>
                                        </Grid>

                                        <!-- メモ項目（件数なし・展開式） -->
                                        <Grid Visibility="{Binding IsCountable, Converter={StaticResource InvBoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- タイトル行 -->
                                            <Grid Grid.Row="0" Margin="6,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsExpanded}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="内容の展開"/>

                                                <!-- 実行チェック（要チェック項目のみ表示） -->
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsExecuted}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                          Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVis}}" ToolTip="実行済みにする"/>

                                                <!-- 項目名（実行済みは薄グレー） -->
                                                <TextBox Grid.Column="2" Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                         Foreground="{Binding IsDimmed, Converter={StaticResource ExecutedBrushConv}}"/>

                                                <!-- 移動ボタン -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,4,0">
                                                    <Button Style="{StaticResource BtnIcon}" Command="{Binding MoveUpCommand}" FontSize="11" Padding="1" ToolTip="上に移動">↑</Button>
                                                    <Button Style="{StaticResource BtnIcon}" Command="{Binding MoveDownCommand}" FontSize="11" Padding="1" ToolTip="下に移動">↓</Button>
                                                </StackPanel>

                                                <!-- 削除ボタン -->
                                                <Button Grid.Column="4" Style="{StaticResource BtnDanger}" Command="{Binding RequestDeleteCommand}" Padding="4,2">🗑</Button>
                                            </Grid>
                                            <!-- 展開エリア -->
                                            <Border Grid.Row="1" Background="{StaticResource BrushBgSecondary}" CornerRadius="0,0,4,4" Padding="12,8" Margin="0,0,0,0"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="内容:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Top"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                                                             Foreground="{StaticResource BrushTextPrimary}" Background="Transparent" BorderThickness="0" FontSize="11"
                                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                                                             VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ＝＝＝ 左ペイン：検索結果ビュー ＝＝＝ -->
            <Grid Grid.Column="0" Margin="15" Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource BtnSecondary}" Command="{Binding ClearSearchCommand}">◀ 戻る</Button>
                    <TextBlock Text="検索結果" FontSize="16" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnDanger}" Margin="10,0,0,0" Command="{Binding DeleteSearchResultsCommand}">一括削除</Button>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5" Padding="10" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.NavigateToResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayText}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Source}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BrushBgSecondary}"/>

            <!-- ＝＝＝ 右ペイン：カレンダー + ToDo ＝＝＝ -->
            <Grid Grid.Column="2" Margin="10,15,15,15" DataContext="{Binding Calendar}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- カレンダー -->
                <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- カレンダーヘッダー -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BtnIcon}" Command="{Binding PrevMonthCommand}">◀</Button>
                                <TextBlock Text="{Binding MonthLabel}" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushTextPrimary}" Margin="10,0"/>
                                <Button Style="{StaticResource BtnIcon}" Command="{Binding NextMonthCommand}">▶</Button>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding GoToTodayCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="6,2"
                                    ToolTip="今日の日付に戻る">
                                <TextBlock Text="📅 今日" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextDecorations="Underline"/>
                            </Button>
                        </Grid>

                        <!-- 曜日ヘッダー -->
                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,5">
                            <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{StaticResource BrushCalWeekend}"/>
                            <TextBlock Text="月" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="火" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="水" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="木" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="金" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="土" HorizontalAlignment="Center" Foreground="{StaticResource BrushCalMarker}"/>
                        </UniformGrid>

                        <!-- 日付セル -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BtnCalDay}" 
                                            Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding HolidayName, Converter={StaticResource StrEmpToNull}}"
                                            Visibility="{Binding DayText, Converter={StaticResource StrEmpToVis}}">
                                        <Grid>
                                            <!-- 今日の日付（薄い塗りつぶし） -->
                                            <Ellipse Width="30" Height="30" Fill="{StaticResource BrushCalToday}" Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}" Opacity="0.3"/>
                                            
                                            <!-- 選択中の日付（塗りつぶし） -->
                                            <Ellipse Width="30" Height="30" Fill="{StaticResource BrushCalSelected}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                            
                                            <!-- 日報またはメモがある日付（枠線） -->
                                            <Ellipse Width="28" Height="28" Stroke="{StaticResource BrushCalMarker}" StrokeThickness="1.5"
                                                     Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}" Opacity="0.6"/>
                                            
                                            <TextBlock Text="{Binding DayText}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       FontWeight="Bold"
                                                       Foreground="{Binding IsHoliday, Converter={StaticResource HolidayBrushConv}}"/>
                                            
                                            <!-- 日報・メモ・ToDoマーカー -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                <Ellipse Width="4" Height="4" Fill="{StaticResource BrushCalMarker}" 
                                                         Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}"/>
                                                <Ellipse Width="4" Height="4" Fill="{StaticResource BrushAccentRed}" Margin="4,0,0,0"
                                                         Visibility="{Binding HasIncompleteTodos, Converter={StaticResource BoolToVis}}"
                                                         ToolTip="未完了のToDoあり"/>
                                                <Ellipse Width="4" Height="4" Fill="{StaticResource BrushAccentOrange}" Margin="4,0,0,0"
                                                         Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ToDoリスト (残タスク) -->
                <Border Grid.Row="1" Background="{StaticResource BrushBgPanel}" CornerRadius="6" Padding="10" DataContext="{Binding DataContext.Todo, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- ヘッダー -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📌 今日のToDo" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                            <Border Background="{StaticResource BrushAccentRed}" CornerRadius="10" Margin="10,0,0,0" Padding="6,2" Visibility="{Binding HasIncompleteTasks, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="未完了あり" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <!-- ToDo検索 -->
                        <Border Grid.Row="1" Background="{StaticResource BrushBgInput}" CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
                            <TextBox Text="{Binding DataContext.TodoSearchText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="12" Foreground="{StaticResource BrushTextPrimary}"
                                     CaretBrush="{StaticResource BrushTextPrimary}"
                                     ToolTip="ToDoを検索（タイトル、内容、時刻）"/>
                        </Border>

                        <!-- ToDoアイテムリスト -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,5" Opacity="{Binding IsCompleted, Converter={StaticResource BoolToOp}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                 <!-- タイトル行 -->
                                                  <Grid Grid.Row="0">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto"/>
                                                          <ColumnDefinition Width="*"/>
                                                          <ColumnDefinition Width="Auto"/>
                                                          <ColumnDefinition Width="Auto"/>
                                                          <ColumnDefinition Width="Auto"/>
                                                          <ColumnDefinition Width="Auto"/>
                                                      </Grid.ColumnDefinitions>
                                                      <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" 
                                                                VerticalAlignment="Center" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}"/>
                                                      <TextBox Grid.Column="1" Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" 
                                                               Foreground="{StaticResource BrushTextPrimary}" Background="Transparent" BorderThickness="0"
                                                               FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"
                                                               IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}"/>
                                                     <TextBlock Grid.Column="2" Text="{Binding TaskDate, StringFormat='{}{0:MM/dd}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0" ToolTip="日付"/>
                                                     <TextBlock Grid.Column="3" Text="{Binding TimeLabel}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                     <TextBlock Grid.Column="4" Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandIcon}}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="5,0" Cursor="Hand">
                                                         <TextBlock.InputBindings>
                                                             <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}"/>
                                                         </TextBlock.InputBindings>
                                                     </TextBlock>
                                                     <Button Grid.Column="5" Style="{StaticResource BtnDanger}" Command="{Binding RequestDeleteCommand}" Margin="5,0,0,0">×</Button>
                                                 </Grid>
                                                <!-- 詳細（インライン展開） -->
                                                <Border Grid.Row="1" Background="{StaticResource BrushBgSecondary}" CornerRadius="4" Padding="8,6" Margin="24,4,0,0"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                          <Grid Grid.Row="0" Margin="0,0,0,4">
                                                              <Grid.ColumnDefinitions>
                                                                  <ColumnDefinition Width="50"/>
                                                                  <ColumnDefinition Width="70"/>
                                                                  <ColumnDefinition Width="Auto"/>
                                                                  <ColumnDefinition Width="70"/>
                                                                  <ColumnDefinition Width="*"/>
                                                              </Grid.ColumnDefinitions>
                                                              <TextBlock Grid.Column="0" Text="時刻:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                              <TextBox Grid.Column="1" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" 
                                                                       Foreground="{StaticResource BrushTextPrimary}" Background="Transparent" BorderThickness="0" FontSize="11"
                                                                       d:Text="17:30" ToolTip="開始時刻"
                                                                       IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}"/>
                                                              <TextBlock Grid.Column="2" Text="～" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" 
                                                                         VerticalAlignment="Center" Margin="4,0"/>
                                                              <TextBox Grid.Column="3" Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" 
                                                                       Foreground="{StaticResource BrushTextPrimary}" Background="Transparent" BorderThickness="0" FontSize="11"
                                                                       d:Text="18:00" ToolTip="終了時刻"
                                                                       IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}"/>
                                                          </Grid>
                                                         <Grid Grid.Row="1">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="50"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Grid.Column="0" Text="内容:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Top"/>
                                                             <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                                                      Foreground="{StaticResource BrushTextPrimary}" Background="Transparent" BorderThickness="0" FontSize="11"
                                                                      TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40"
                                                                      d:Text="材質・仕上げ、ネジ 講師：山口"
                                                                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}"/>
                                                         </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 新規タスク追加 -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}" d:Text="タイトルを入力..." Margin="0,0,5,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddTodoCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Command="{Binding AddTodoCommand}">追加</Button>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewStartTime, UpdateSourceTrigger=PropertyChanged}" d:Text="開始" FontSize="11" ToolTip="開始時刻（例: 17:30）"/>
                                <TextBlock Grid.Column="1" Text="～" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                                <TextBox Grid.Column="2" Text="{Binding NewEndTime, UpdateSourceTrigger=PropertyChanged}" d:Text="終了" FontSize="11" ToolTip="終了時刻（例: 18:00）"/>
                                <TextBox Grid.Column="3" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" d:Text="詳細" FontSize="11" ToolTip="詳細内容（自由メモ）" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ステータスバー -->
        <Border Grid.Row="3" Background="{StaticResource BrushAccentMint}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
        </Border>

        <!-- 起動時のスケジュール通知ダイアログ（オーバーレイ） -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsStartupMessageVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderAccent}" BorderThickness="2" CornerRadius="8" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25" MinWidth="350">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{Binding StartupMessage}" FontSize="15" LineHeight="24" Margin="0,0,0,20" Foreground="{StaticResource BrushTextPrimary}"/>
                    
                    <Button Grid.Row="1" Style="{StaticResource BtnPrimary}" Command="{Binding CloseStartupMessageCommand}" Width="120" HorizontalAlignment="Center">確認しました</Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
