<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════
         カラーパレット（オーシャンブルーアクセント・ダークテーマ）
    ══════════════════════════════════════════════════════════════ -->
    <Color x:Key="BgPrimary">#FF0F172A</Color>
    <Color x:Key="BgSecondary">#FF1E293B</Color>
    <Color x:Key="BgPanel">#FF334155</Color>
    <Color x:Key="BgHover">#FF475569</Color>
    <Color x:Key="BgInput">#FF475569</Color>
    <Color x:Key="BgSelected">#FF0369A1</Color>
    <Color x:Key="AccentMint">#FF0EA5E9</Color>
    <Color x:Key="AccentGreen">#FF0284C7</Color>
    <Color x:Key="AccentRed">#FFCF6679</Color>
    <Color x:Key="AccentOrange">#FFCE9178</Color>
    <Color x:Key="TextPrimary">#FFF0F0F0</Color>
    <Color x:Key="TextSecondary">#FFA0A4A8</Color>
    <Color x:Key="TextMuted">#FF6A6A6A</Color>
    <Color x:Key="BorderColor">#FF475569</Color>
    <Color x:Key="BorderAccent">#FF0EA5E9</Color>
    <Color x:Key="CalMarker">#FF80CBC4</Color>
    <Color x:Key="CalToday">#FF00BCD4</Color>
    <Color x:Key="CalSelected">#FF0369A1</Color>
    <Color x:Key="CalWeekend">#FFCF6679</Color>

    <!-- SolidColorBrush -->
    <SolidColorBrush x:Key="BrushBgPrimary"    Color="{StaticResource BgPrimary}"/>
    <SolidColorBrush x:Key="BrushBgSecondary"  Color="{StaticResource BgSecondary}"/>
    <SolidColorBrush x:Key="BrushBgPanel"      Color="{StaticResource BgPanel}"/>
    <SolidColorBrush x:Key="BrushBgHover"      Color="{StaticResource BgHover}"/>
    <SolidColorBrush x:Key="BrushBgInput"      Color="{StaticResource BgInput}"/>
    <SolidColorBrush x:Key="BrushBgSelected"   Color="{StaticResource BgSelected}"/>
    <SolidColorBrush x:Key="BrushAccentMint"   Color="{StaticResource AccentMint}"/>
    <SolidColorBrush x:Key="BrushAccentGreen"  Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="BrushAccentRed"    Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="BrushAccentOrange" Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="BrushTextPrimary"  Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted"    Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="BrushBorder"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BrushBorderAccent" Color="{StaticResource BorderAccent}"/>
    <SolidColorBrush x:Key="BrushCalMarker"    Color="{StaticResource CalMarker}"/>
    <SolidColorBrush x:Key="BrushCalToday"     Color="{StaticResource CalToday}"/>
    <SolidColorBrush x:Key="BrushCalSelected"  Color="{StaticResource CalSelected}"/>
    <SolidColorBrush x:Key="BrushCalWeekend"   Color="{StaticResource CalWeekend}"/>
    <SolidColorBrush x:Key="BrushTransparent"  Color="Transparent"/>

    <!-- ══════════════════════════════════════════════════════════════
         フォント
    ══════════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="FontMain">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
    <Style TargetType="TextElement">
        <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         Window 基本スタイル
    ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="Window">
        <Setter Property="Background"  Value="{StaticResource BrushBgPrimary}"/>
        <Setter Property="Foreground"  Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="FontFamily"  Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"    Value="13"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         TextBox スタイル
    ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background"            Value="{StaticResource BrushBgInput}"/>
        <Setter Property="Foreground"            Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"           Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness"       Value="1"/>
        <Setter Property="Padding"               Value="6,4"/>
        <Setter Property="FontFamily"            Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"              Value="13"/>
        <Setter Property="CaretBrush"            Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="SelectionBrush"        Value="{StaticResource BrushBgSelected}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 検索TextBox（デフォルト適用） -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>

    <!-- ══════════════════════════════════════════════════════════════
         Button スタイル群
    ══════════════════════════════════════════════════════════════ -->

    <!-- プライマリボタン（ミントグリーン） -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource BrushAccentMint}"/>
        <Setter Property="Foreground"   Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF00E676"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF009624"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- セカンダリボタン（グレー） -->
    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"      Value="10,5"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危険ボタン（赤：削除用） -->
    <Style x:Key="BtnDanger" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushAccentRed}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="6,4"/>
        <Setter Property="FontSize"     Value="14"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="ToolTip"      Value="削除"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33CF6679"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#55CF6679"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- アイコン小ボタン（+-ナビなど） -->
    <Style x:Key="BtnIcon" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"        Value="28"/>
        <Setter Property="Height"       Value="28"/>
        <Setter Property="FontSize"     Value="16"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- カレンダー日付ボタン -->
    <Style x:Key="BtnCalDay" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"        Value="32"/>
        <Setter Property="Height"       Value="32"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" Width="30" Height="30"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushBgPanel}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         CheckBox スタイル
    ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Bd" Width="16" Height="16"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1.5" CornerRadius="3"
                                Background="{StaticResource BrushBgInput}"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M2,8 L6,12 L14,4"
                                  Stroke="{StaticResource BrushAccentMint}"
                                  StrokeThickness="2" Visibility="Collapsed"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Bd"    Property="BorderBrush" Value="{StaticResource BrushAccentMint}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentMint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         ScrollBar スタイル（スリム・ダーク）
    ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width"      Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#555555" CornerRadius="3" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         ListBox スタイル
    ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="ListBox">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Foreground"       Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Padding"      Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         DataGrid スタイル（ダークテーマ対応）
    ══════════════════════════════════════════════════════════════ -->

    <Style TargetType="DataGridTextColumn">
        <Setter Property="EditingElementStyle">
            <Setter.Value>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                    <Setter Property="Background" Value="{StaticResource BrushBgInput}"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="Foreground"               Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="RowBackground"            Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BrushBgSecondary}"/>
        <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="HeadersVisibility"        Value="Column"/>
        <Setter Property="FontFamily"               Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
    </Style>

    <Style TargetType="DataGridRow">
<Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight"    Value="32"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBgHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBgSelected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"   Value="{StaticResource BrushBgSecondary}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding"      Value="6,4"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         ComboBox スタイル（ダークテーマ対応）
    ══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background"           Value="{StaticResource BrushBgInput}"/>
        <Setter Property="Foreground"           Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"          Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness"      Value="1"/>
        <Setter Property="Padding"              Value="6,4"/>
        <Setter Property="FontFamily"           Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"             Value="13"/>
        <Setter Property="MinHeight"            Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Path Grid.Column="1"
                                  Data="M0,0 L6,0 L3,5 Z"
                                  Fill="{StaticResource BrushTextSecondary}"
                                  VerticalAlignment="Center"
                                  Margin="4,0"
                                  IsHitTestVisible="False"/>
                        </Grid>
                        <ToggleButton Style="{StaticResource ComboBoxToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Popup Name="Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource BrushBgPanel}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background"   Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Padding"      Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBgHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBgSelected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         Separator スタイル
    ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="Separator">
        <Setter Property="Background"   Value="{StaticResource BrushBorder}"/>
        <Setter Property="Height"       Value="1"/>
        <Setter Property="Margin"       Value="0,4"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         ToolTip スタイル
    ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background"   Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"      Value="8,4"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"     Value="12"/>
    </Style>

</ResourceDictionary>

