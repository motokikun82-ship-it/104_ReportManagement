<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         繧ｫ繝ｩ繝ｼ繝代Ξ繝・ヨ・医Α繝ｳ繝医げ繝ｪ繝ｼ繝ｳ繧｢繧ｯ繧ｻ繝ｳ繝医・繝繝ｼ繧ｯ繝・・繝橸ｼ・    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
    <Color x:Key="BgPrimary">#FF1A1D23</Color>
    <Color x:Key="BgSecondary">#FF21252B</Color>
    <Color x:Key="BgPanel">#FF282C34</Color>
    <Color x:Key="BgHover">#FF333842</Color>
    <Color x:Key="BgInput">#FF383D45</Color>
    <Color x:Key="BgSelected">#FF1B6E3A</Color>
    <Color x:Key="AccentMint">#FF00C853</Color>
    <Color x:Key="AccentGreen">#FF2E7D32</Color>
    <Color x:Key="AccentRed">#FFCF6679</Color>
    <Color x:Key="AccentOrange">#FFCE9178</Color>
    <Color x:Key="TextPrimary">#FFF0F0F0</Color>
    <Color x:Key="TextSecondary">#FFA0A4A8</Color>
    <Color x:Key="TextMuted">#FF6A6A6A</Color>
    <Color x:Key="BorderColor">#FF383D45</Color>
    <Color x:Key="BorderAccent">#FF00C853</Color>
    <Color x:Key="CalMarker">#FF80CBC4</Color>
    <Color x:Key="CalToday">#FF00BCD4</Color>
    <Color x:Key="CalSelected">#FF1B6E3A</Color>
    <Color x:Key="CalWeekend">#FFCF6679</Color>

    <!-- SolidColorBrush -->
    <SolidColorBrush x:Key="BrushBgPrimary"    Color="{StaticResource BgPrimary}"/>
    <SolidColorBrush x:Key="BrushBgSecondary"  Color="{StaticResource BgSecondary}"/>
    <SolidColorBrush x:Key="BrushBgPanel"      Color="{StaticResource BgPanel}"/>
    <SolidColorBrush x:Key="BrushBgHover"      Color="{StaticResource BgHover}"/>
    <SolidColorBrush x:Key="BrushBgInput"      Color="{StaticResource BgInput}"/>
    <SolidColorBrush x:Key="BrushBgSelected"   Color="{StaticResource BgSelected}"/>
    <SolidColorBrush x:Key="BrushAccentMint"   Color="{StaticResource AccentMint}"/>
    <SolidColorBrush x:Key="BrushAccentGreen"  Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="BrushAccentRed"    Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="BrushAccentOrange" Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="BrushTextPrimary"  Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted"    Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="BrushBorder"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BrushBorderAccent" Color="{StaticResource BorderAccent}"/>
    <SolidColorBrush x:Key="BrushCalMarker"    Color="{StaticResource CalMarker}"/>
    <SolidColorBrush x:Key="BrushCalToday"     Color="{StaticResource CalToday}"/>
    <SolidColorBrush x:Key="BrushCalSelected"  Color="{StaticResource CalSelected}"/>
    <SolidColorBrush x:Key="BrushCalWeekend"   Color="{StaticResource CalWeekend}"/>
    <SolidColorBrush x:Key="BrushTransparent"  Color="Transparent"/>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         繝輔か繝ｳ繝・    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
    <FontFamily x:Key="FontMain">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
    <Style TargetType="TextElement">
        <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         Window 蝓ｺ譛ｬ繧ｹ繧ｿ繧､繝ｫ
    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
    <Style TargetType="Window">
        <Setter Property="Background"  Value="{StaticResource BrushBgPrimary}"/>
        <Setter Property="Foreground"  Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="FontFamily"  Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"    Value="13"/>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         TextBox 繧ｹ繧ｿ繧､繝ｫ
    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background"            Value="{StaticResource BrushBgInput}"/>
        <Setter Property="Foreground"            Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"           Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness"       Value="1"/>
        <Setter Property="Padding"               Value="6,4"/>
        <Setter Property="FontFamily"            Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"              Value="13"/>
        <Setter Property="CaretBrush"            Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="SelectionBrush"        Value="{StaticResource BrushBgSelected}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 讀懃ｴ｢TextBox・医ョ繝輔か繝ｫ繝磯←逕ｨ・・-->
    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         Button 繧ｹ繧ｿ繧､繝ｫ鄒､
    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->

    <!-- 繝励Λ繧､繝槭Μ繝懊ち繝ｳ・医Α繝ｳ繝医げ繝ｪ繝ｼ繝ｳ・・-->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource BrushAccentMint}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF00E676"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF009624"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 繧ｻ繧ｫ繝ｳ繝繝ｪ繝懊ち繝ｳ・医げ繝ｬ繝ｼ・・-->
    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"      Value="10,5"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 蜊ｱ髯ｺ繝懊ち繝ｳ・郁ｵ､・壼炎髯､逕ｨ・・-->
    <Style x:Key="BtnDanger" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushAccentRed}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="6,4"/>
        <Setter Property="FontSize"     Value="14"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="ToolTip"      Value="蜑企勁"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33CF6679"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#55CF6679"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 繧｢繧､繧ｳ繝ｳ蟆上・繧ｿ繝ｳ・・-繝翫ン縺ｪ縺ｩ・・-->
    <Style x:Key="BtnIcon" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"        Value="28"/>
        <Setter Property="Height"       Value="28"/>
        <Setter Property="FontSize"     Value="16"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 繧ｫ繝ｬ繝ｳ繝繝ｼ譌･莉倥・繧ｿ繝ｳ -->
    <Style x:Key="BtnCalDay" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"        Value="32"/>
        <Setter Property="Height"       Value="32"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" Width="30" Height="30"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushBgPanel}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         CheckBox 繧ｹ繧ｿ繧､繝ｫ
    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Bd" Width="16" Height="16"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1.5" CornerRadius="3"
                                Background="{StaticResource BrushBgInput}"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M2,8 L6,12 L14,4"
                                  Stroke="{StaticResource BrushAccentMint}"
                                  StrokeThickness="2" Visibility="Collapsed"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Bd"    Property="BorderBrush" Value="{StaticResource BrushAccentMint}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentMint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         ScrollBar 繧ｹ繧ｿ繧､繝ｫ・医せ繝ｪ繝繝ｻ繝繝ｼ繧ｯ・・    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
        <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BrushTextMuted}" CornerRadius="3" Margin="1" Opacity="0.5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="6"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="6"/>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         ListBox 繧ｹ繧ｿ繧､繝ｫ
    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
    <Style TargetType="ListBox">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Foreground"       Value="{StaticResource BrushTextPrimary}"/>

    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Padding"      Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         DataGrid 繧ｹ繧ｿ繧､繝ｫ・医ム繝ｼ繧ｯ繝・・繝槫ｯｾ蠢懶ｼ・    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->

    <Style TargetType="DataGridTextColumn">
        <Setter Property="EditingElementStyle">
            <Setter.Value>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                    <Setter Property="Background" Value="{StaticResource BrushBgInput}"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="Foreground"               Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="RowBackground"            Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BrushBgSecondary}"/>
        <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="HeadersVisibility"        Value="Column"/>
        <Setter Property="FontFamily"               Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
    </Style>

    <Style TargetType="DataGridRow">
<Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight"    Value="32"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBgHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBgSelected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"   Value="{StaticResource BrushBgSecondary}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding"      Value="6,4"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         ComboBox 繧ｹ繧ｿ繧､繝ｫ・医ム繝ｼ繧ｯ繝・・繝槫ｯｾ蠢懶ｼ・    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->

    <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background"           Value="{StaticResource BrushBgInput}"/>
        <Setter Property="Foreground"           Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"          Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness"      Value="1"/>
        <Setter Property="Padding"              Value="6,4"/>
        <Setter Property="FontFamily"           Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"             Value="13"/>
        <Setter Property="MinHeight"            Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Path Grid.Column="1"
                                  Data="M0,0 L6,0 L3,5 Z"
                                  Fill="{StaticResource BrushTextSecondary}"
                                  VerticalAlignment="Center"
                                  Margin="4,0"
                                  IsHitTestVisible="False"/>
                        </Grid>
                        <ToggleButton Style="{StaticResource ComboBoxToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Popup Name="Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource BrushBgPanel}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background"   Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Padding"      Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBgHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBgSelected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         Calendar 繧ｹ繧ｿ繧､繝ｫ・医ム繝ｼ繧ｯ繝・・繝槫ｯｾ蠢懶ｼ・    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->

    <!-- Calendar 譛ｬ菴・-->
    <Style TargetType="Calendar">
        <Setter Property="Background"   Value="{StaticResource BrushBgInput}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <!-- CalendarDayButton・壽律莉倥・謨ｰ蟄励・繧ｿ繝ｳ -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground"       Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="MinWidth"         Value="30"/>
        <Setter Property="MinHeight"        Value="30"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" Width="28" Height="28"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 莉頑律 -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushCalToday}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <!-- 驕ｸ謚樊律 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushCalSelected}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!-- 莉匁怦縺ｮ譌･莉假ｼ医げ繝ｬ繝ｼ繧｢繧ｦ繝茨ｼ・-->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                        </Trigger>
                        <!-- 繝帙ヰ繝ｼ -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                        <!-- 辟｡蜉ｹ -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarButton・壼ｹｴ繝ｻ譛医・驕ｸ謚槭・繧ｿ繝ｳ・亥ｹｴ/譛医ン繝･繝ｼ蛻・崛譎ゅ↓陦ｨ遉ｺ・・-->
    <Style TargetType="CalendarButton">
        <Setter Property="Foreground"       Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="MinWidth"         Value="40"/>
        <Setter Property="MinHeight"        Value="42"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <Rectangle x:Name="Bg" Fill="{TemplateBinding Background}" RadiusX="4" RadiusY="4"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushBgHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         Separator 繧ｹ繧ｿ繧､繝ｫ
    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
    <Style TargetType="Separator">
        <Setter Property="Background"   Value="{StaticResource BrushBorder}"/>
        <Setter Property="Height"       Value="1"/>
        <Setter Property="Margin"       Value="0,4"/>
    </Style>

    <!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
         ToolTip 繧ｹ繧ｿ繧､繝ｫ
    笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background"   Value="{StaticResource BrushBgPanel}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"      Value="8,4"/>
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"     Value="12"/>
    </Style>

</ResourceDictionary>

