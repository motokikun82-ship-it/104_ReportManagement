<Window x:Class="ReportManagement.Views.FavoriteItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⭐ テンプレート" Height="585" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgPrimary}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- グループ選択 -->
        <TextBlock Grid.Row="0" Text="グループを選択" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="1" x:Name="CmbGroups"
                  DisplayMemberPath="GroupName"
                  SelectionChanged="CmbGroups_SelectionChanged"
                  Margin="0,0,0,6"
                  Background="{StaticResource BrushBgInput}"
                  Foreground="{StaticResource BrushTextPrimary}"/>

        <!-- グループの項目 -->
        <TextBlock Grid.Row="2" x:Name="LblGroupItems" Text="グループの項目（Ctrl+クリックで複数選択）" FontWeight="Bold" Margin="0,0,0,4"/>
        <ListBox Grid.Row="3" x:Name="LbGroupItems" SelectionMode="Extended"
                 Margin="0,0,0,6"
                 Background="{StaticResource BrushBgPanel}"
                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ItemName}" Padding="6,4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 過去の履歴 -->
        <Border Grid.Row="4" Background="{StaticResource BrushBorder}" Height="1" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="4" Text="過去の履歴（Ctrl+クリックで複数選択）" FontWeight="Bold"
                   Background="{StaticResource BrushBgPrimary}" Padding="0,0,8,0" HorizontalAlignment="Left"
                   Margin="0,-10,0,4"/>
        <ListBox Grid.Row="5" x:Name="LbHistory" SelectionMode="Extended"
                 MinHeight="50" Margin="0,0,0,4"
                 Background="{StaticResource BrushBgPanel}"
                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" Padding="6,4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 管理ボタン -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Style="{StaticResource BtnSecondary}" Click="BtnOpenTemplateManager_Click">📋 テンプレ管理</Button>
        </StackPanel>

        <!-- 下部ボタン -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource BtnPrimary}" Click="BtnAddToDate_Click" Margin="0,0,10,0" IsDefault="True">選択を今日の日報に追加</Button>
            <Button Style="{StaticResource BtnSecondary}" Click="BtnClose_Click" IsCancel="True">閉じる</Button>
        </StackPanel>
    </Grid>
</Window>
