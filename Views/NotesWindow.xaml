<Window x:Class="ReportManagement.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📝 メモ管理" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgPrimary}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 検索＋操作バー -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtSearch"
                         TextChanged="TxtSearch_TextChanged"
                         Margin="0,0,10,0"/>
                <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Click="BtnNew_Click" Margin="0,0,5,0">＋ 新規作成</Button>
                <Button Grid.Column="2" Style="{StaticResource BtnDanger}" Click="BtnDelete_Click">🗑 削除</Button>
            </Grid>
        </Border>

        <!-- メイン 2カラム -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：メモ一覧 -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 メモ一覧" FontWeight="Bold" Margin="10,8,10,4"/>
                    <ListBox Grid.Row="1" x:Name="LbNotes" SelectionChanged="LbNotes_SelectionChanged"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock Text="{Binding Preview}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右：エディター -->
            <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="✏️ メモ編集" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtTitle" Margin="0,0,8,0"/>
                        <DatePicker Grid.Column="1" x:Name="DpDate"
                                    Background="{StaticResource BrushBgInput}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    Width="140"/>
                    </Grid>

                    <TextBox Grid.Row="2" x:Name="TxtContent"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="8"
                             VerticalContentAlignment="Top"
                             Background="{StaticResource BrushBgInput}"
                             BorderBrush="{StaticResource BrushBorder}"
                             Foreground="{StaticResource BrushTextPrimary}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 下部：保存ボタン＋ステータス -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="LblStatus" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Click="BtnSave_Click" IsDefault="True" Padding="20,6">💾 保存</Button>
        </Grid>
    </Grid>
</Window>
