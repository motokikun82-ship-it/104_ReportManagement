<Window x:Class="ReportManagement.Views.ScheduleTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📅 テンプレート項目のスケジュール登録" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgPrimary}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Window.Resources>
        <!--
            ★ カレンダースタイルを明示的に適用するため、x:Key を付与
        -->
        <Style x:Key="MyCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="MinWidth"        Value="30"/>
            <Setter Property="MinHeight"       Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Grid>
                            <!-- 背景の丸 -->
                            <Ellipse x:Name="Bg"
                                     Fill="{TemplateBinding Background}"
                                     Width="28" Height="28"/>
                            <!-- 日付数字：テーマ標準の文字色を使用 -->
                            <ContentPresenter x:Name="Cp"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 今日 -->
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushCalToday}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <!-- 選択日 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushCalSelected}"/>
                            </Trigger>
                            <!-- 他月の日付（グレーアウト） -->
                            <Trigger Property="IsInactive" Value="True">
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource BrushTextMuted}"/>
                            </Trigger>
                            <!-- ホバー -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushBgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CalendarButton: 年/月ビュー切替ボタン -->
        <Style x:Key="MyCalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="MinWidth"        Value="40"/>
            <Setter Property="MinHeight"       Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Grid>
                            <Rectangle x:Name="Bg" Fill="{TemplateBinding Background}" RadiusX="4" RadiusY="4"/>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BrushBgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MyCalendarItemStyle" TargetType="CalendarItem">
            <Setter Property="Background"      Value="{StaticResource BrushBgInput}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 月ヘッダー（前月・年月・次月） -->
                                <Grid Grid.Row="0" Background="{StaticResource BrushBgPanel}" Margin="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                     <!-- テーマ標準の文字色を使用 -->
                                    <Button x:Name="PART_PreviousButton" Grid.Column="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4"
                                            Foreground="{StaticResource BrushTextPrimary}">
                                        <TextBlock Text="◀" FontSize="12"/>
                                    </Button>
                                    <Button x:Name="PART_HeaderButton" Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{StaticResource BrushTextPrimary}">
                                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="PART_NextButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4"
                                            Foreground="{StaticResource BrushTextPrimary}">
                                        <TextBlock Text="▶" FontSize="12"/>
                                    </Button>
                                </Grid>

                                <!-- 曜日行＋日付グリッド -->
                                <Grid Grid.Row="1" Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- 曜日行（固定テキスト） -->
                                    <UniformGrid Grid.Row="0" Columns="7" Margin="0,2,0,4">
                                        <TextBlock Text="日" Foreground="{StaticResource BrushCalWeekend}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="月" Foreground="{StaticResource BrushTextPrimary}"   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="火" Foreground="{StaticResource BrushTextPrimary}"   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="水" Foreground="{StaticResource BrushTextPrimary}"   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="木" Foreground="{StaticResource BrushTextPrimary}"   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="金" Foreground="{StaticResource BrushTextPrimary}"   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="土" Foreground="{StaticResource BrushCalMarker}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </UniformGrid>
                                    <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Days of week -->
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>

                                    <!-- 年/10年ビュー -->
                                    <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Group selection -->
            <RowDefinition Height="*"/>    <!-- Main Content (Side-by-side) -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ステップ1: グループ選択 -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁 グループ:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbGroup" Width="250" ItemsSource="{Binding TemplateGroups}" 
                          DisplayMemberPath="GroupName" SelectedValuePath="Id"
                          SelectionChanged="CmbGroup_SelectionChanged"
                          ToolTip="テンプレートグループを選択"/>
                <TextBlock x:Name="TxtItemCount" VerticalAlignment="Center" Margin="15,0,0,0" 
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- メインコンテンツ（左右分割） -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/> <!-- Margin/Gutter -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ステップ2: 項目選択（左側） -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 登録する項目（複数選択可）:" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox x:Name="LbItems" Grid.Row="1" SelectionMode="Extended" 
                             Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorder}"
                             Foreground="{StaticResource BrushTextPrimary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding ItemName}" FontWeight="Bold" Width="180"/>
                                    <TextBlock Text="{Binding DefaultCount, StringFormat='  既定件数: {0}件'}" 
                                               Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IsCountable, StringFormat='  {0}'}" 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ステップ3: カレンダーで日付選択（右側） -->
            <Border Grid.Column="2" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="📅 登録日を選択:" FontWeight="Bold" Margin="0,0,0,8"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="RbSingle" Content="単日選択" GroupName="DateMode" IsChecked="True" 
                                     Margin="0,0,10,0" VerticalAlignment="Center" Checked="DateMode_Changed"
                                     Foreground="{StaticResource BrushTextPrimary}"/>
                        <RadioButton x:Name="RbMulti" Content="複数日選択" GroupName="DateMode" 
                                     Margin="0,0,10,0" VerticalAlignment="Center" Checked="DateMode_Changed"
                                     Foreground="{StaticResource BrushTextPrimary}"/>
                        <RadioButton x:Name="RbRange" Content="期間指定" GroupName="DateMode" 
                                     VerticalAlignment="Center" Checked="DateMode_Changed"
                                     Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="SpRange" Grid.Row="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,0,0,8">
                        <TextBlock Text="開始:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker x:Name="DpStart" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="終了:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker x:Name="DpEnd" Width="100"/>
                    </StackPanel>

                    <!-- カレンダー -->
                    <Calendar x:Name="CalMain" Grid.Row="3" SelectionMode="SingleDate" 
                              Background="{StaticResource BrushBgInput}"
                              BorderBrush="{StaticResource BrushBorder}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              CalendarItemStyle="{StaticResource MyCalendarItemStyle}"
                              CalendarDayButtonStyle="{StaticResource MyCalendarDayButtonStyle}"
                              CalendarButtonStyle="{StaticResource MyCalendarButtonStyle}"
                              SelectedDatesChanged="CalMain_SelectedDatesChanged">
                    </Calendar>
                </Grid>
            </Border>
        </Grid>

        <!-- 選択日一覧 & 登録ボタン -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="LblSelectedDates" Grid.Column="0" VerticalAlignment="Center" 
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                
                <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Click="BtnPreview_Click" 
                        Margin="0,0,10,0" Padding="15,6">👁 プレビュー</Button>
                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Click="BtnRegister_Click" 
                        IsDefault="True" Padding="20,6">✅ 登録実行</Button>
            </Grid>
        </Border>
    </Grid>
</Window>