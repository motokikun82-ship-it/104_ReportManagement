<Window x:Class="ReportManagement.Views.AggregationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:ReportManagement.ViewModels"
        xmlns:conv="clr-namespace:ReportManagement.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="&#x1F4CA; 集計レポート" Height="750" Width="1200"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing"
        Background="{StaticResource BrushBgPrimary}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Window.Resources>
        <conv:RadioButtonConverter x:Key="RadioBtnConv"/>
        <conv:PeriodModeVisibilityConverter x:Key="PeriodModeVisConv"/>
        <x:StaticExtension x:Key="PeriodModeMonthly" Member="vm:PeriodMode.Monthly"/>
        <x:StaticExtension x:Key="PeriodModeYearly" Member="vm:PeriodMode.Yearly"/>
        <x:StaticExtension x:Key="PeriodModeCustom" Member="vm:PeriodMode.Custom"/>
        <x:StaticExtension x:Key="ChartTypeLine" Member="vm:ChartTypeMode.Line"/>
        <x:StaticExtension x:Key="ChartTypeStackedBar" Member="vm:ChartTypeMode.StackedBar"/>
        <x:StaticExtension x:Key="DisplayUnitDay" Member="vm:DisplayUnit.Day"/>
        <x:StaticExtension x:Key="DisplayUnitWeek" Member="vm:DisplayUnit.Week"/>
        <x:StaticExtension x:Key="DisplayUnitMonth" Member="vm:DisplayUnit.Month"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 行1: 期間選択 -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="月別" GroupName="PeriodMode" Margin="0,0,20,0"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 IsChecked="{Binding PeriodMode, Converter={StaticResource RadioBtnConv}, ConverterParameter={StaticResource PeriodModeMonthly}}"/>
                    <RadioButton Content="年別" GroupName="PeriodMode" Margin="0,0,20,0"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 IsChecked="{Binding PeriodMode, Converter={StaticResource RadioBtnConv}, ConverterParameter={StaticResource PeriodModeYearly}}"/>
                    <RadioButton Content="カスタム期間" GroupName="PeriodMode"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 IsChecked="{Binding PeriodMode, Converter={StaticResource RadioBtnConv}, ConverterParameter={StaticResource PeriodModeCustom}}"/>
                </StackPanel>

                <!-- 月別パラメータ -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding PeriodMode, Converter={StaticResource PeriodModeVisConv}, ConverterParameter={StaticResource PeriodModeMonthly}}">
                    <TextBlock Text="年:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource BrushTextSecondary}"/>
                    <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" Width="80"/>
                </StackPanel>

                <!-- 年別パラメータ -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding PeriodMode, Converter={StaticResource PeriodModeVisConv}, ConverterParameter={StaticResource PeriodModeYearly}}">
                    <TextBlock Text="集計範囲:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding YearRangeLabel}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- カスタム期間パラメータ -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding PeriodMode, Converter={StaticResource PeriodModeVisConv}, ConverterParameter={StaticResource PeriodModeCustom}}">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource BrushTextSecondary}"/>
                    <DatePicker SelectedDate="{Binding CustomStart}" Width="130" Margin="0,0,8,0"/>
                    <TextBlock Text="～" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource BrushTextSecondary}"/>
                    <DatePicker SelectedDate="{Binding CustomEnd}" Width="130"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 行2: グループタブバー -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="0" Margin="0,0,0,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding GroupName}" Padding="12,6" FontWeight="Bold"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- 行3: グループ内項目フィルタ -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="12" Margin="0,0,0,8"
                MinHeight="60">
            <ContentControl Content="{Binding SelectedGroup}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:ItemGroupViewModel">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="全選択" Command="{Binding SelectAllCommand}"
                                        Style="{StaticResource BtnSecondary}" Padding="8,3" Margin="0,0,4,0"/>
                                <Button Content="全解除" Command="{Binding DeselectAllCommand}"
                                        Style="{StaticResource BtnSecondary}" Padding="8,3"/>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding ItemName}"
                                                      Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,14,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

        <!-- 行4: グラフ種類切替＋表示単位 -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="グラフ種類:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource BrushTextSecondary}"/>
                <RadioButton Content="折れ線グラフ" GroupName="ChartType" Margin="0,0,16,0"
                             Foreground="{StaticResource BrushTextPrimary}"
                             IsChecked="{Binding ChartType, Converter={StaticResource RadioBtnConv}, ConverterParameter={StaticResource ChartTypeLine}}"/>
                <RadioButton Content="積み上げ棒グラフ" GroupName="ChartType"
                             Foreground="{StaticResource BrushTextPrimary}"
                             IsChecked="{Binding ChartType, Converter={StaticResource RadioBtnConv}, ConverterParameter={StaticResource ChartTypeStackedBar}}"/>
                <TextBlock Text="  │  " VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource BrushTextSecondary}"/>
                <TextBlock Text="表示単位:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource BrushTextSecondary}"/>
                <RadioButton Content="日" GroupName="DisplayUnit" Margin="0,0,12,0"
                             Foreground="{StaticResource BrushTextPrimary}"
                             IsChecked="{Binding DisplayUnit, Converter={StaticResource RadioBtnConv}, ConverterParameter={StaticResource DisplayUnitDay}}"/>
                <RadioButton Content="週" GroupName="DisplayUnit" Margin="0,0,12,0"
                             Foreground="{StaticResource BrushTextPrimary}"
                             IsChecked="{Binding DisplayUnit, Converter={StaticResource RadioBtnConv}, ConverterParameter={StaticResource DisplayUnitWeek}}"/>
                <RadioButton Content="月" GroupName="DisplayUnit"
                             Foreground="{StaticResource BrushTextPrimary}"
                             IsChecked="{Binding DisplayUnit, Converter={StaticResource RadioBtnConv}, ConverterParameter={StaticResource DisplayUnitMonth}}"/>
            </StackPanel>
        </Border>

        <!-- 行5: メインコンテンツ（表＋グラフ） -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：DataGrid -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="4" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding AggregationTable}"
                          AutoGenerateColumns="True"
                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          ClipboardCopyMode="IncludeHeader"
                          SelectionMode="Extended"
                          GridLinesVisibility="All"
                          BorderThickness="0"
                          Background="{StaticResource BrushBgPanel}"
                          Foreground="{StaticResource BrushTextPrimary}"
                          RowHeaderWidth="0"
                          FontSize="11"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BrushBgSecondary}"/>

            <!-- 右：LiveCharts グラフ -->
            <Border Grid.Column="2" Background="{StaticResource BrushBgPanel}" CornerRadius="4" Padding="4">
                <lvc:CartesianChart
                    Series="{Binding Series}"
                    XAxes="{Binding XAxes}"
                    YAxes="{Binding YAxes}"
                    ZoomMode="X"
                    TooltipPosition="Top"/>
            </Border>
        </Grid>

        <!-- 行6: フッター -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Command="{Binding CopyToClipboardCommand}" Margin="0,0,8,0" Padding="12,6">
                クリップボードにコピー
            </Button>
            <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" Padding="12,6">
                CSVエクスポート
            </Button>
            <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Click="BtnClose_Click" Padding="16,6" IsCancel="True">
                閉じる
            </Button>
        </Grid>
    </Grid>
</Window>
